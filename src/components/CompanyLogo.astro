---
interface Props {
  company: string
  size?: number
}

const { company, size = 48 } = Astro.props

const logoUrls: Record<string, string> = {
  'Kawan Lama Group': '/klg-logo.jpg',
  'Mekari': '/mekari-logo.png',
  'Admedika': '/telkom-logo.png',
  'AsiaCommerce': '/asiacommerce-logo.png',
}

const logoUrl = logoUrls[company]

const initials = company
  .split(' ')
  .map((w) => w[0])
  .join('')
  .toUpperCase()
  .substring(0, 2)

const logoStyle = `width:${size}px;height:${size}px;`
const initialsStyle = `width:${size}px;height:${size}px;`
---

<div class="company-logo">
  {logoUrl ? (
    <>
      <img
        src={logoUrl}
        alt={`${company} logo`}
        class="company-logo-img"
        style={logoStyle}
        onerror="this.classList.add('hidden');this.nextElementSibling.classList.remove('hidden');this.nextElementSibling.classList.add('flex');"
      />
      <div class="company-logo-initials hidden" style={initialsStyle}>{initials}</div>
    </>
  ) : (
    <div class="company-logo-initials flex" style={initialsStyle}>{initials}</div>
  )}
</div>
