---
import {
  siRuby,
  siRubyonrails,
  siGo,
  siJavascript,
  siReact,
  siNodedotjs,
  siPostgresql,
  siMysql,
  siMongodb,
  siRedis,
  siDocker,
  siKubernetes,
  siGit,
  siAmazonwebservices,
} from 'simple-icons/icons'

// Icons whose brand color is very light (near-white) or very dark — needs adaptive handling
// We store the hex and handle contrast in CSS
const technologies = [
  { name: 'Ruby', icon: siRuby },
  { name: 'Ruby on Rails', icon: siRubyonrails },
  { name: 'Go', icon: siGo },
  { name: 'JavaScript', icon: siJavascript },
  { name: 'React', icon: siReact },
  { name: 'Node.js', icon: siNodedotjs },
  { name: 'PostgreSQL', icon: siPostgresql },
  { name: 'MySQL', icon: siMysql },
  { name: 'MongoDB', icon: siMongodb },
  { name: 'Redis', icon: siRedis },
  { name: 'Docker', icon: siDocker },
  { name: 'Kubernetes', icon: siKubernetes },
  { name: 'Git', icon: siGit },
  { name: 'AWS', icon: siAmazonwebservices },
]

// Determine if a hex color is light (luminance > 0.5)
function isLight(hex: string): boolean {
  const r = parseInt(hex.slice(0, 2), 16) / 255
  const g = parseInt(hex.slice(2, 4), 16) / 255
  const b = parseInt(hex.slice(4, 6), 16) / 255
  return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.6
}

function isDark(hex: string): boolean {
  const r = parseInt(hex.slice(0, 2), 16) / 255
  const g = parseInt(hex.slice(2, 4), 16) / 255
  const b = parseInt(hex.slice(4, 6), 16) / 255
  return 0.2126 * r + 0.7152 * g + 0.0722 * b < 0.15
}
---

<section id="tech-stack" class="section">
  <div class="container">
    <h2>Tech Stack</h2>
    <div class="tech-grid">
      {technologies.map((tech) => (
        <div class="tech-item">
          <svg
            role="img"
            viewBox="0 0 24 24"
            width="40"
            height="40"
            class={`tech-icon ${isLight(tech.icon.hex) ? 'tech-icon--light-brand' : ''} ${isDark(tech.icon.hex) ? 'tech-icon--dark-brand' : ''}`}
            style={`--brand-color: #${tech.icon.hex}`}
            aria-label={tech.name}
          >
            <path d={tech.icon.path} />
          </svg>
          <span class="tech-name">{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>
