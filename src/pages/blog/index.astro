---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import Layout from '../../layouts/Layout.astro'
import ThemeToggle from '../../components/ThemeToggle.astro'
import avatar from '../../assets/avatar.png'

const posts = await getCollection('blog')
const sortedPosts = posts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
)

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}
---

<Layout
  title="Blog - Irvan Eksa Mahendra"
  description="Personal thoughts on self-development and reflection, sometimes about tech."
>
  <div class="medium-blog">

    <!-- Navbar -->
    <nav class="medium-nav">
      <a href="/" class="medium-nav-logo">Irvan Mahendra</a>
      <div class="medium-nav-links">
        <a href="/work">Work</a>
        <a href="/blog">Blog</a>
        <ThemeToggle />
      </div>
    </nav>

    <!-- Feed header -->
    <div class="medium-feed-header">
      <h1>Writing</h1>
      <p>Personal thoughts on self-development and reflection, sometimes about tech.</p>
    </div>

    <!-- Post feed -->
    <main class="medium-feed">
      {sortedPosts.length === 0 && (
        <div class="feed-empty">
          <p>No posts yet. Check back soon.</p>
        </div>
      )}
      {sortedPosts.map((post) => (
        <a href={`/blog/${post.slug}`} class="feed-item">
          <div class="feed-item-body">
            <div class="feed-item-author">
              <Image src={avatar} alt="Irvan" width={20} height={20} class="feed-author-avatar" loading="eager" />
              <span>Irvan Mahendra</span>
              <span class="feed-dot">·</span>
              <span>{formatDate(post.data.publishedAt)}</span>
            </div>
            <h2 class="feed-item-title">{post.data.title}</h2>
            {post.data.excerpt && (
              <p class="feed-item-excerpt">{post.data.excerpt}</p>
            )}
            <div class="feed-item-footer">
              <span class="feed-reading-time">{post.data.readingTime} min read</span>
              {post.data.tags.slice(0, 2).map((tag) => (
                <span class="feed-tag">{tag}</span>
              ))}
            </div>
          </div>
          {post.data.featuredImage && (
            <img
              src={post.data.featuredImage}
              alt={post.data.title}
              class="feed-item-thumbnail"
            />
          )}
        </a>
      ))}
    </main>

  </div>
</Layout>
