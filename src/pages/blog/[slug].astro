---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import Layout from '../../layouts/Layout.astro'
import ThemeToggle from '../../components/ThemeToggle.astro'
import avatar from '../../assets/avatar.png'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await post.render()

const siteUrl = 'https://irvanmahendra.com'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.publishedAt.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Irvan Eksa Mahendra',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Person',
    name: 'Irvan Eksa Mahendra',
    url: siteUrl,
  },
  url: `${siteUrl}/blog/${post.slug}/`,
  ...(post.data.featuredImage && { image: `${siteUrl}${post.data.featuredImage}` }),
}

const allPosts = await getCollection('blog')
const currentTags = new Set(post.data.tags)
const suggestedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .map((p) => {
    const sharedTags = p.data.tags.filter((t) => currentTags.has(t)).length
    return { post: p, sharedTags }
  })
  .sort((a, b) =>
    b.sharedTags !== a.sharedTags
      ? b.sharedTags - a.sharedTags
      : b.post.data.publishedAt.getTime() - a.post.data.publishedAt.getTime()
  )
  .slice(0, 3)
  .map(({ post }) => post)

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
}
---

<Layout
  title={`${post.data.title} - Irvan Eksa Mahendra`}
  description={post.data.excerpt}
  image={post.data.featuredImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="medium-article-page">

    <!-- Navbar -->
    <nav class="medium-nav">
      <a href="/blog" class="medium-nav-logo">Irvan Mahendra</a>
      <ThemeToggle />
    </nav>

    <!-- Article -->
    <main class="medium-article-main">
      <article class="medium-article">

        <!-- Title -->
        <h1 class="article-title">{post.data.title}</h1>

        <!-- Subtitle / excerpt -->
        {post.data.excerpt && (
          <p class="article-subtitle">{post.data.excerpt}</p>
        )}

        <!-- Author row -->
        <div class="article-author-row">
          <Image src={avatar} alt="Irvan" width={44} height={44} class="article-author-avatar" loading="eager" />
          <div class="article-author-info">
            <span class="article-author-name">Irvan Eksa Mahendra</span>
            <div class="article-author-meta">
              <span>{formatDate(post.data.publishedAt)}</span>
              <span class="feed-dot">·</span>
              <span>{post.data.readingTime} min read</span>
            </div>
          </div>
        </div>

        <!-- Tags -->
        {post.data.tags.length > 0 && (
          <div class="article-tags">
            {post.data.tags.map((tag) => (
              <span class="article-tag">{tag}</span>
            ))}
          </div>
        )}

        <hr class="article-divider" />

        <!-- Featured image -->
        {post.data.featuredImage && (
          <img
            src={post.data.featuredImage}
            alt={post.data.title}
            class="article-featured-image"
          />
        )}

        <!-- Body -->
        <div class="medium-prose">
          <Content />
        </div>

      </article>

      <!-- More from -->
      {suggestedPosts.length > 0 && (
        <section class="more-from">
          <div class="more-from-header">
            <Image src={avatar} alt="Irvan" width={48} height={48} class="more-from-avatar" loading="lazy" />
            <div>
              <p class="more-from-label">More from</p>
              <p class="more-from-author">Irvan Eksa Mahendra</p>
            </div>
          </div>
          <div class="more-from-grid">
            {suggestedPosts.map((p) => (
              <a href={`/blog/${p.slug}`} class="more-from-card">
                <div class="more-from-card-meta">
                  {formatDate(p.data.publishedAt)}
                  <span class="feed-dot">·</span>
                  {p.data.readingTime} min read
                </div>
                <h3 class="more-from-card-title">{p.data.title}</h3>
                {p.data.excerpt && (
                  <p class="more-from-card-excerpt">{p.data.excerpt}</p>
                )}
              </a>
            ))}
          </div>
        </section>
      )}

    </main>
  </div>
</Layout>
